{
  "framework": "vite",
  "crons": [
    {
      "path": "/api/cron/compact",
      "schedule": "0 3 * * 1"
    }
  ],
  "rewrites": [
    { "source": "/api/teams", "destination": "/api/auth" },
    { "source": "/api/events-batch", "destination": "/api/events" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
